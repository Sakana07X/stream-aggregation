<Page x:Class="StreamingAggregation.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- 固定色值而非主题资源：错误提示必须在任何主题（含高对比度）下都可读，
             而且不依赖特定 WinAppSDK 版本才引入的主题画刷键。 -->
        <SolidColorBrush x:Key="SettingsErrorForegroundBrush" Color="#C42B1C" />
    </Page.Resources>

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="24" MaxWidth="600" HorizontalAlignment="Left">

                <!-- SnowLuma 连接 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="SnowLuma 连接" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox Header="主机" PlaceholderText="127.0.0.1"
                             Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <NumberBox Header="端口" PlaceholderText="3001" Minimum="1" Maximum="65535"
                               Value="{Binding Port, Mode=TwoWay}" />
                    <PasswordBox Header="Token" PlaceholderText="连接令牌"
                                 Password="{Binding Token, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="使用 SSL" IsChecked="{Binding UseSsl, Mode=TwoWay}" />
                </StackPanel>

                <!-- 群白名单 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="群白名单" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="每行一个群 ID" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" PlaceholderText="123456789&#x0a;987654321"
                             Text="{Binding WhitelistText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- 模型配置 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="模型配置" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox Header="API 端点" PlaceholderText="https://api.example.com/v1"
                             Text="{Binding Endpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <PasswordBox Header="API Key" PlaceholderText="sk-..."
                                 Password="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Header="模型名称" PlaceholderText="gpt-4o"
                             Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <NumberBox Header="超时（秒）" PlaceholderText="30" Minimum="1"
                               Value="{Binding TimeoutSeconds, Mode=TwoWay}" />
                </StackPanel>

                <!-- 聚合窗口 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="聚合窗口" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <NumberBox Header="窗口时长（分钟）" PlaceholderText="3" Minimum="1" Maximum="1440"
                               Value="{Binding WindowMinutes, Mode=TwoWay}" />
                    <NumberBox Header="保留天数" PlaceholderText="30" Minimum="1"
                               Value="{Binding RetentionDays, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 保存区：结果提示与错误提示 -->
        <StackPanel Grid.Row="2" Spacing="4" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource SettingsErrorForegroundBrush}"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <Button Content="保存" Click="SaveButton_Click" HorizontalAlignment="Left"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{Binding CanSave}" />
        </StackPanel>
    </Grid>
</Page>