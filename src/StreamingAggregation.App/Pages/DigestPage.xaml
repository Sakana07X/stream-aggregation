<Page x:Class="StreamingAggregation.App.Pages.DigestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:StreamingAggregation.Core.Models">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="摘要" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <!-- 紧急 -->
                <StackPanel>
                    <TextBlock Text="紧急" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <ItemsControl x:Name="UrgentList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Digest">
                                <Border BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Reason}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 待办 -->
                <StackPanel>
                    <TextBlock Text="待办" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <ItemsControl x:Name="TodoList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Digest">
                                <Border BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Reason}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 学习 -->
                <StackPanel>
                    <TextBlock Text="学习" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <ItemsControl x:Name="StudyList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Digest">
                                <Border BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Reason}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 普通 -->
                <StackPanel>
                    <TextBlock Text="普通" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ItemsControl x:Name="NormalList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Digest">
                                <Border BorderBrush="{ThemeResource SystemFillColorNeutralBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Reason}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
