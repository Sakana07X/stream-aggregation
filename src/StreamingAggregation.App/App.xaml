<Application x:Class="StreamingAggregation.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    主题资源字典在阶段 2 保持为空，界面直接用 WPF 系统默认主题（Aero2 / Windows 10+ 现代主题）。
    WinUI 时期的 XamlControlsResources 已随 WinUI 3 一并移除，它在 WPF 里不存在。
    TODO(阶段 3): 需要统一深色/浅色主题时在此处合并自定义 ResourceDictionary。
  -->
  <Application.Resources>
    <ResourceDictionary />
  </Application.Resources>

  <!--
    ShutdownMode 刻意【不在 XAML 里写死】：托盘常驻需要 OnExplicitShutdown，
    但「关窗即退出」也是一种合理诉求（无障碍、远程桌面场景）。
    因此本属性由 App.OnStartup 调 ShutdownModeResolver.Resolve 决定，
    支持命令行开关与环境变量两处入口，详见该类的说明。
  -->
</Application>