<Window x:Class="StreamingAggregation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StreamingAggregation.App"
        xmlns:nav="clr-namespace:StreamingAggregation.App.Navigation"
        Width="1100"
        Height="720"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Theme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel>
    <!-- 底部状态条 -->
    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Padding="12,6"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
      <TextBlock x:Name="StatusTextBlock" Text="正在连接…" Style="{StaticResource CaptionTextStyle}"/>
    </Border>

    <!-- 导航壳 -->
    <nav:NavShell x:Name="MainNavShell"/>
  </DockPanel>
</Window>
